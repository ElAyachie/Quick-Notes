<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One theme for light and dark: the colours it points at switch with the night qualifier. -->
    <style name="Theme.QuickNotes" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/on_tertiary</item>
        <item name="colorTertiaryContainer">@color/tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/on_tertiary_container</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_low</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_container_highest</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>

        <!-- Raised surfaces keep the colour they are given instead of being tinted in the dark
             theme; the theme's surface colours already tell the layers apart. -->
        <item name="elevationOverlayEnabled">false</item>

        <item name="materialCardViewStyle">@style/Widget.QuickNotes.Card</item>
        <item name="extendedFloatingActionButtonStyle">@style/Widget.QuickNotes.ExtendedFab</item>
        <item name="materialButtonStyle">@style/Widget.QuickNotes.Button</item>
        <item name="materialIconButtonFilledStyle">@style/Widget.QuickNotes.IconButton</item>
        <item name="drawerArrowStyle">@style/Widget.QuickNotes.BackArrow</item>
    </style>

    <!-- Buttons keep the brand red in both themes, like the app bar. -->
    <style name="Widget.QuickNotes.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/button_background</item>
        <item name="android:textColor">@color/button_content</item>
        <item name="iconTint">@color/button_content</item>
    </style>

    <style name="Widget.QuickNotes.IconButton" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="backgroundTint">@color/button_background</item>
        <item name="iconTint">@color/button_content</item>
    </style>

    <!-- List rows are flat, tinted cards with a touch ripple. -->
    <style name="Widget.QuickNotes.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/card</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.QuickNotes.Card</item>
    </style>

    <style name="ShapeAppearance.QuickNotes.Card" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- A panel that sits over the bottom of a screen: rounded at the top only. -->
    <style name="ShapeAppearance.QuickNotes.BottomPanel" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- The main action of a screen, in the brand red like the other buttons. -->
    <style name="Widget.QuickNotes.ExtendedFab" parent="Widget.Material3.ExtendedFloatingActionButton.Icon.Primary">
        <item name="backgroundTint">@color/app_bar</item>
        <item name="android:textColor">@color/on_app_bar</item>
        <item name="iconTint">@color/on_app_bar</item>
    </style>

    <!-- A tab strip that continues the app bar. -->
    <style name="Widget.QuickNotes.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="android:background">@color/app_bar</item>
        <item name="tabGravity">fill</item>
        <item name="tabIndicatorColor">@color/on_app_bar</item>
        <item name="tabMode">fixed</item>
        <item name="tabSelectedTextColor">@color/on_app_bar</item>
        <item name="tabTextColor">@color/on_app_bar_muted</item>
    </style>

    <!-- The toolbar's back arrow is drawn by the navigation library and takes its colour from here. -->
    <style name="Widget.QuickNotes.BackArrow" parent="Widget.AppCompat.DrawerArrowToggle">
        <item name="color">@color/on_app_bar</item>
    </style>
</resources>
